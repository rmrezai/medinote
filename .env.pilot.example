# MediNote pilot deployment environment
# Copy to .env.pilot and replace every CHANGE_ME value before starting.
MEDINOTE_ENVIRONMENT=pilot
MEDINOTE_DOMAIN=medinote.example.org
MEDINOTE_CORS_ORIGINS=https://medinote.example.org

POSTGRES_DB=medinote
POSTGRES_USER=medinote_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://medinote_app:CHANGE_ME_STRONG_DATABASE_PASSWORD@db:5432/medinote

# Used only by encrypted backup scripts. Store outside source control.
BACKUP_PASSPHRASE=CHANGE_ME_LONG_RANDOM_BACKUP_PASSPHRASE
BACKUP_RETENTION_DAYS=14

# Pilot security policy
SESSION_HOURS=12
TEST_BYPASS_AUTH=false
ENABLE_API_DOCS=false
# Step 49 immutable retention. Generate exactly 32 random bytes and encode as 64 hex chars.
RETENTION_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHAR_KEY
IMMUTABLE_STORE_PATH=/var/lib/medinote-immutable
DEFAULT_RETENTION_DAYS=2555
